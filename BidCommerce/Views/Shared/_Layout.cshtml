@using Microsoft.AspNetCore.Identity
@using BidCommerce.Data
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BidCommerce</title>
    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/layout.css" />
</head>
<!-- Added flexbox classes for sticky footer layout -->
<body class="d-flex flex-column min-vh-100">
    <!-- Modern Navigation -->
    <nav class="modern-navbar">
        <div class="container d-flex align-items-center">
            <!-- Brand -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-logo">
                    <i class="bi bi-bag" style="color: white; font-size: 16px;"></i>
                </div>
                <span class="brand-name">BidCommerce</span>
            </a>

            <!-- Search Bar -->
            <div class="search-container">
                <form class="search-form" asp-controller="Products" asp-action="Search" method="get">
                    <input type="search" name="query" class="search-input" placeholder="Search for anything..." aria-label="Search">
                    <button type="submit" class="search-btn">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <!-- Navigation Items -->
            <div class="nav-items">
                @if (SignInManager.IsSignedIn(User))
                {
                    <!-- Buyers Dropdown -->
                    <div class="dropdown">
                        <button class="nav-btn dropdown-toggle" type="button" id="buyersDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-search"></i> Buyers
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="buyersDropdown">
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Index"><i class="bi bi-grid"></i> Browse Products</a></li>
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Watchlist"><i class="bi bi-heart"></i> My Watchlist</a></li>
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="MyBids"><i class="bi bi-hammer"></i> My Bids</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Help" asp-action="HowToBid"><i class="bi bi-question-circle"></i> How to Bid</a></li>
                            <li><a class="dropdown-item" asp-controller="Help" asp-action="BuyerProtection"><i class="bi bi-shield-check"></i> Buyer Protection</a></li>
                        </ul>
                    </div>

                    <!-- Sellers Dropdown -->
                    <div class="dropdown">
                        <button class="nav-btn btn-sell dropdown-toggle" type="button" id="sellersDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-plus"></i> Sellers
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="sellersDropdown">
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-circle"></i> List New Item</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a></li>
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="MyListings"><i class="bi bi-list-ul"></i> My Listings</a></li>
                            <li><a class="dropdown-item" asp-controller="Seller" asp-action="Analytics"><i class="bi bi-graph-up"></i> Sales Analytics</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Help" asp-action="FeesAndPricing"><i class="bi bi-currency-dollar"></i> Fees & Pricing</a></li>
                            <li><a class="dropdown-item" asp-controller="SellerOnboarding" asp-action="Index"><i class="bi bi-credit-card"></i> Payment Setup</a></li>
                        </ul>
                    </div>

                    <!-- Account Dropdown -->
                    <div class="dropdown">
                        <button class="nav-btn dropdown-toggle" type="button" id="accountDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> Account
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="accountDropdown">
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person"></i> My Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings"><i class="bi bi-gear"></i> Settings</a></li>
                            <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-box"></i> Order History</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline w-100">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="nav-btn btn-login">
                        Login
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="nav-btn btn-register">
                        Register
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- Added flex-grow-1 to push footer to bottom -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto">
        <div class="container">
            <div class="row">
                <!-- Brand Column -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="footer-brand">
                        <div class="footer-logo">
                            <i class="bi bi-bag" style="color: white; font-size: 20px;"></i>
                        </div>
                        <span class="footer-brand-name">BidCommerce</span>
                    </div>
                    <p class="footer-description">
                        The world's largest online auction marketplace with millions of unique items.
                    </p>
                </div>

                <!-- For Buyers Column -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="footer-title">For Buyers</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Help" asp-action="HowToBid">How to Bid</a></li>
                        <li><a asp-controller="Help" asp-action="BuyerProtection">Buyer Protection</a></li>
                        <li><a asp-controller="Help" asp-action="PaymentMethods">Payment Methods</a></li>
                    </ul>
                </div>

                <!-- For Sellers Column -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="footer-title">For Sellers</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Products" asp-action="Create">Start Selling</a></li>
                        <li><a asp-controller="Seller" asp-action="Dashboard">Seller Center</a></li>
                        <li><a asp-controller="Help" asp-action="FeesAndPricing">Fees & Pricing</a></li>
                    </ul>
                </div>

                <!-- Support Column -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="footer-title">Support</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Help" asp-action="Index">Help Center</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                        <li><a asp-controller="Community" asp-action="Index">Community</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2024 BidCommerce. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- SignalR and global chat connection scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/chat-connection.js"></script>
    <script>
        // Initialize global chat connection when DOM is ready
        let globalChatConnection = null;

        document.addEventListener("DOMContentLoaded", async function () {
            console.log("Initializing global chat connection...");

            if (typeof ChatConnection !== 'undefined') {
                try {
                    globalChatConnection = new ChatConnection();
                    const success = await globalChatConnection.initialize();

                    if (success) {
                        console.log("Global chat connection initialized successfully");
                        window.globalChatConnection = globalChatConnection;
                    } else {
                        console.error("Failed to initialize global chat connection");
                    }
                } catch (error) {
                    console.error("Error initializing chat connection:", error);
                }
            } else {
                console.error("ChatConnection class not found");
            }
        });
    </script>

    <!-- Bootstrap JS for dropdown functionality -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
