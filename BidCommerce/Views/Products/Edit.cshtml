@model BidCommerce.ViewModels.ProductCreateViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<link rel="stylesheet" href="~/css/create-products.css" />
<div class="content-wrapper">
    <div class="form-column">
        <div class="main-container">
            <!-- Updated title and subtitle for edit page -->
            <h1 class="main-title">Edit Product</h1>
            <p class="main-subtitle">Update your product listing details</p>

            <!-- Added success/error message alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mb-4">
                    <i class="bi bi-check-circle"></i>
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mb-4">
                    <i class="bi bi-exclamation-triangle"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="productForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <!-- Added hidden fields for edit functionality -->
                <input type="hidden" asp-for="Product.Id" />
                <input type="hidden" asp-for="Product.OwnerId" />
                <input type="hidden" asp-for="Product.CreatedAt" />

                <div class="form-section">
                    <h3 class="section-title">
                        <i class="bi bi-tag"></i> Listing Type
                    </h3>
                    <p class="section-subtitle">Choose how you want to sell your item</p>
                    <div class="listing-type-cards">
                        <!-- Set active state based on current product data -->
                        <div class="listing-card @(Model.Product.IsBiddable ? "active" : "")" id="auctionCard">
                            <div class="listing-icon">
                                <i class="bi bi-clock"></i>
                            </div>
                            <div class="listing-title">Auction</div>
                            <div class="listing-description">Let buyers bid on your item</div>
                        </div>
                        <div class="listing-card @(!Model.Product.IsBiddable ? "active" : "")" id="fixedPriceCard">
                            <div class="listing-icon">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                            <div class="listing-title">Fixed Price</div>
                            <div class="listing-description">Sell at a set price</div>
                        </div>
                    </div>
                    <!-- Set value based on current product data -->
                    <input asp-for="Product.IsBiddable" type="hidden" id="isBiddableInput" value="@Model.Product.IsBiddable.ToString().ToLower()" />
                </div>

                <div class="form-section">
                    <h3 class="section-title">Item Details</h3>
                    <p class="section-subtitle">Provide information about your item</p>
                    <div class="mb-3">
                        <label asp-for="Product.Title" class="form-label">Title <span class="required">*</span></label>
                        <input asp-for="Product.Title" class="form-control" placeholder="Enter item title" oninput="updatePreview()" />
                        <span asp-validation-for="Product.Title" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Product.Description" class="form-label">Description</label>
                        <textarea asp-for="Product.Description" class="form-control" rows="4" placeholder="Describe your item in detail" oninput="updatePreview()"></textarea>
                        <span asp-validation-for="Product.Description" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Product.CategoryId" class="form-label">Category</label>
                            <!-- Set selected value based on current product data -->
                            <select asp-for="Product.CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "CategoryId", "Name", Model.Product.CategoryId))" onchange="updatePreview()">
                                <option value="">Select category</option>
                            </select>
                            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Product.ConditionId" class="form-label">Condition</label>
                            <!-- Set selected value based on current product data -->
                            <select asp-for="Product.ConditionId" class="form-select" asp-items="@(new SelectList(Model.Condition, "ConditionId", "Name", Model.Product.ConditionId))" onchange="updatePreview()">
                                <option value="">Select condition</option>
                            </select>
                            <span asp-validation-for="Product.ConditionId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="section-title">
                        <i class="bi bi-currency-dollar"></i> Pricing
                    </h3>
                    <p class="section-subtitle" id="pricingSubtitle">@(Model.Product.IsBiddable ? "Set your auction details" : "Set your fixed price for this item")</p>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Product.BuyNowPrice" class="form-label" id="buyNowLabel">@(Model.Product.IsBiddable ? "Buy Now Price (Optional)" : "Price")</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Product.BuyNowPrice" class="form-control" placeholder="199.99" step="0.01" id="buyNowPriceInput" oninput="updatePreview()" />
                            </div>
                            <span asp-validation-for="Product.BuyNowPrice" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Show/hide auction fields based on current product type -->
                    <div class="auction-fields @(Model.Product.IsBiddable ? "show" : "")" id="auctionFields">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Product.StartingPrice" class="form-label">Starting Bid</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Product.StartingPrice" class="form-control" placeholder="0.99" step="0.01" oninput="updatePreview()" />
                                </div>
                                <span asp-validation-for="Product.StartingPrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Current Bid</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <!-- Show current bid value -->
                                    <input value="@(Model.Product.CurrentBid?.ToString("F2") ?? "0.00")" class="form-control" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Product.BidEndTime" class="form-label">Auction End Date & Time</label>
                                <!-- Format datetime for input -->
                                <input asp-for="Product.BidEndTime" type="datetime-local" class="form-control" id="bidEndTimeInput" value="@(Model.Product.BidEndTime?.ToString("yyyy-MM-ddTHH:mm"))" />
                                <span asp-validation-for="Product.BidEndTime" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="section-title">Photos</h3>
                    <p class="section-subtitle">Update photos of your item (up to 12 photos)</p>

                    <!-- Show current images if they exist -->
                    @if (Model.Product.Images != null && Model.Product.Images.Any())
                    {
                        <div class="current-images mb-4">
                            <h5>Current Images</h5>
                            <div class="drag-drop-zone" id="currentImagesZone">
                                <div class="images-grid" id="currentImagesGrid">
                                    @for (int i = 0; i < Model.Product.Images.Count; i++)
                                    {
                                        var image = Model.Product.Images.ElementAt(i);
                                        <div class="image-thumbnail" data-image-id="@image.Id">
                                            <img src="@image.ImageUrl" alt="Product image" />
                                            <div class="image-order-badge">@(i + 1)</div>
                                            <button type="button" class="delete-image-btn" onclick="deleteExistingImage(@image.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="upload-area" onclick="document.getElementById('imageUpload').click()">
                        <div class="upload-icon">
                            <i class="bi bi-cloud-upload"></i>
                        </div>
                        <div class="upload-title">Upload New Photos</div>
                        <div class="upload-subtitle">Drag and drop your photos here, or click to browse</div>
                        <button type="button" class="btn btn-choose-files">Choose Files</button>
                    </div>
                    <input type="file" name="ImageFiles" id="imageUpload" class="file-input" accept="image/*" multiple style="display: none;" onchange="handleImageUpload(this)" />
                    <div id="dynamicFileInputs"></div>
                    <div id="imagePreviewContainer" class="mt-3">
                        <div class="selected-images-info" id="selectedImagesInfo" style="display: none;">
                            <p class="mb-2"><strong>New Images:</strong> <span id="imageCount">0</span>/12</p>
                        </div>
                        <div class="drag-drop-zone" id="dragDropZone">
                            <div class="images-grid" id="imagesGrid"></div>
                        </div>
                        <div class="drag-instructions" id="dragInstructions" style="display: none;">
                            Drag and drop images to reorder them
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <!-- Updated buttons for edit functionality -->
                    <a asp-action="Details" asp-route-id="@Model.Product.Id" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Product
                    </a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="bi bi-save"></i> Update Listing
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="preview-column">
        <div class="preview-container">
            <div class="preview-header">
                <h3>Preview</h3>
                <p>How your updated listing will appear</p>
            </div>

            <div class="preview-image" id="previewImage">
                <!-- Show first existing image or placeholder -->
                @if (Model.Product.Images != null && Model.Product.Images.Any())
                {
                    <img src="@Model.Product.Images.First().ImageUrl" alt="Product preview" id="previewImg" />
                }
                else
                {
                    <i class="bi bi-image" style="font-size: 40px;"></i>
                }
            </div>

            <div class="preview-content">
                <!-- Show current product data in preview -->
                <div class="preview-category" id="previewCategory">@(Model.Categories?.FirstOrDefault(c => c.CategoryId == Model.Product.CategoryId)?.Name ?? "Select category")</div>
                <div class="preview-title" id="previewTitle">@(string.IsNullOrEmpty(Model.Product.Title) ? "Enter product title" : Model.Product.Title)</div>
                <div class="preview-description" id="previewDescription">@(string.IsNullOrEmpty(Model.Product.Description) ? "Add a description for your product" : Model.Product.Description)</div>
                <div class="preview-price" id="previewPrice">
                    @if (Model.Product.IsBiddable)
                    {
                        @:Current Bid: $@((Model.Product.CurrentBid ?? Model.Product.StartingPrice ?? 0).ToString("F2"))
                    }
                    else
                    {
                        @:Price: $@((Model.Product.BuyNowPrice ?? 0).ToString("F2"))
                    }
                </div>

                <div class="preview-stats">
                    <!-- Show actual product stats -->
                    <span><i class="bi bi-eye"></i> @Model.Product.Views views</span>
                    <span id="previewTimeLeft">
                        @if (Model.Product.IsBiddable && Model.Product.BidEndTime.HasValue)
                        {
                            <i class="bi bi-clock"></i>
                            @if (Model.Product.BidEndTime > DateTime.Now)
                            {
                                @:Ends @Model.Product.BidEndTime.Value.ToString("MMM dd")
                            }
                            else
                            {
                                @:Auction Ended
                            }
                        }
                        else
                        {
                            <i class="bi bi-clock"></i> @:Available
                        }
                    </span>
                </div>

                <button class="preview-button" id="previewButton">
                    <i class="bi bi-cart-plus"></i>
                    <span id="previewButtonText">@(Model.Product.IsBiddable ? "Place Bid" : "Buy Now")</span>
                </button>
            </div>

            <div class="preview-heart">
                <i class="bi bi-heart"></i>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/create-product.js"></script>
}
